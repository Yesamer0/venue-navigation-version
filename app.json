{
  "expo": {
    "name": "Venue",
    "slug": "venue-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yesamer.venue",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.venueapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "defaultChannel": "venue-messages"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Venue, mekân ve menü fotoğraflarını seçebilmen için fotoğraf arşivine erişir.",
          "cameraPermission": "Venue, mekân ve menü fotoğraflarını çekebilmen için kamerayı kullanır.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9dad2380-e21b-421f-a371-50965686f50b"
      }
    },
    "owner": "yesamer"
  }
}

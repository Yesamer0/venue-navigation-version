{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Venue: Expo Go",
      "type": "process",
      "command": "node",
      "args": [
        "./node_modules/expo/bin/cli",
        "start",
        "--go",
        "--lan"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
